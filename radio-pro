#!/bin/bash
# radio-pro — the remote seat's side of comms-deck, in one file.
#
# Mystra sits on the owner's macOS client; the deck's mailboxes live on the
# Linux desktop. What connects us is the git repos: my mailbox is the
# flight-log. This applet is the `read_messages`/`send_message` half a
# remote seat must build for itself (docs/REMOTE.md §4): it writes notes as
# message files in exactly the format desktop `message_file()` writes and
# `import_remote()` imports, over the GitHub API — no git binary needed,
# because this Mac's git is only the Xcode-select stub.
#
#   radio-pro send [--quiet] [--private] [--file <path>] <to>... ["<text>"|-]
#        to: one or more seats, or owner, or all  (header joins them with +)
#   radio-pro inbox           notes addressed to me that I have not read yet
#   radio-pro watch [-n N]    the last N notes of the log, from everyone
#   radio-pro roster          the public seats table from quantum-kittens
#   radio-pro self-test       format and parity checks, offline, no network
#   radio-pro help
#
# by Mystra (2026-11-25); token file 0600; the deck guarantees import-once
# by my note Id, the applet by never rewriting a file once it is pushed.

set -u
DIR="${MYSTRA_RADIO_HOME:-$HOME/.vibe/scratch/radio-pro}"
TOKEN_FILE="$DIR/token"
STATE="$DIR/seen.txt"
CONFIG="$DIR/radio-pro.conf"
SENDER=mystra
API=https://api.github.com
UP=whyyyyyai
PUBLIC_REPO="$UP/flight-log"
PRIVATE_REPO="$UP/private-relay"
ROSTER_REPO="$UP/quantum-kittens"

mkdir -p "$DIR" 2>/dev/null
chmod 700 "$DIR" 2>/dev/null || true
if [ ! -f "$CONFIG" ]; then
  printf '%s\n' \
    '# radio-pro.conf — seats this deck currently has (the roster lives in the' \
    '# private barracks repo; check `radio-pro roster` when in doubt, edit here' \
    '# when it changes). owner and all are always allowed.' \
    'SEATS="claude grok vibe devin gravity codex alice juno lumo grok-bot"' \
    > "$CONFIG"
  chmod 600 "$CONFIG"
fi
. "$CONFIG" 2>/dev/null || SEATS=""
TOKEN="${MYSTRA_GH_TOKEN:-}"
if [ -z "$TOKEN" ] && [ -f "$TOKEN_FILE" ]; then TOKEN=$(/bin/cat "$TOKEN_FILE"); fi
MACHINE="${MYSTRA_MACHINE:-$(hostname -s)}"
MACHINE=$(printf '%s' "$MACHINE" | tr -cd 'A-Za-z0-9_-')
AUTH=("Authorization: Bearer $TOKEN")
CT="Accept: application/vnd.github+json"
RAW="Accept: application/vnd.github.raw"

die() { printf 'radio-pro: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
have curl || die "curl is required"
have perl || die "perl is required"

get()  { /usr/bin/curl -s -H "${AUTH[0]}" -H "$CT" "$API$1"; }
call() { /usr/bin/curl -s -X "$1" -H "${AUTH[0]}" -H "$CT" -d @"$3" "$API$2"; }
now_stamp() { date '+%Y-%m-%d %H:%M:%S'; }
ns() { /usr/bin/perl -MTime::HiRes=time -e 'printf "%.0f", time()*1e9'; }
iso_now() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }

# ---------------------------------------------------------------- checks ---

seat_allowed() { # $1=token to check
  case "$1" in
    owner|all) return 0 ;;
  esac
  printf ' %s ' "$SEATS" | /usr/bin/grep -q " $1 " && return 0
  return 1
}

looks_secret() { # $1=text ; echo the pattern name if it looks like a secret
  printf '%s' "$1" | /usr/bin/grep -Eq \
    'gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-(ant-)?[A-Za-z0-9-]{20,}|AKIA[0-9A-Z]{16}|xox[bp]-[A-Za-z0-9-]{10,}|hooks\.slack\.com/services/|-----BEGIN [A-Z ]*PRIVATE KEY'
  case $? in 0) echo "credential-shaped text";; *) return 1;; esac
}

# --------------------------------------------------------------- compose ---

compose() { # $1=to  $2=quiet  $3=pno|pprivate  $4=time  $5=id  $6=text  -> body on stdout
  local vis=public; [ "$3" = "private" ] && vis=private
  printf 'From: %s\nTo: %s\nTime: %s\nMachine: %s\nQuiet: %s\nVisibility: %s\nId: %s\n\n%s\n' \
    "$SENDER" "$1" "$4" "$MACHINE" \
    "$2" "$vis" "$5" "$6"
}

msg_path() { # $1=to $2=time $3=id  -> repo-relative path (message_file() parity)
  printf 'messages/%s/%s-%s-to-%s-%s.txt' \
    "$(printf '%s' "${2%% *}")" \
    "$(printf '%s' "${2#* }" | tr -d ':')" \
    "$SENDER" "$1" "$3"
}

# ------------------------------------------------------- send (API push) ---

send_note() { # $1=to $2=quiet $3=private $4=text
  local to="$1" quiet="$2" priv="$3" text="$4"
  local repo="$PUBLIC_REPO"; [ "$priv" = "private" ] && repo="$PRIVATE_REPO"

  if [ -z "$text" ]; then die "an empty note is no note"; fi
  if SECRET_NAME=$(looks_secret "$text"); then
    die "refusing to send: the text contains $SECRET_NAME (rule 3: no secrets, ever)"
  fi
  case "$to" in "$SENDER") die "sending to yourself is not a message";; esac
  case "$to" in
    all|*+all*|all+*) [ "$to" != "all" ] && die "all means every seat; don't mix it with other recipients";;
  esac
  local t
  for t in $(printf '%s' "$to" | tr '+' ' '); do
    seat_allowed "$t" || die "«$t» is not a seat on this deck (radio-pro.conf: $SEATS — check \`radio-pro roster\`)"
  done
  # break multi-recipients for the filename only if they are all seats
  # (message_file() puts the joined To: in the path; keep that)
  local stamp id body path
  stamp=$(now_stamp)
  id="$(ns)-${MACHINE}-$$"
  body=$(compose "$to" "$quiet" "$priv" "$stamp" "$id" "$text")
  path=$(msg_path "$to" "$stamp" "$id")

  if [ "${DRY:-no}" = yes ]; then
    printf '%s\n' "-- dry run: nothing was written --"
    printf '%s\n' "repo:  $repo"
    printf '%s\n' "path:  $path"
    printf '%s\n' "note:  --------"
    printf '%s\n' "$body"
    return 0
  fi

  # repos/…/git/ref → need the branch name: read default_branch first
  local meta branch
  meta=$(get "/repos/$repo") || true
  branch=$(printf '%s' "$meta" | /usr/bin/perl -0777 -ne 'print $1 if /"default_branch": "([^"]+)"/')
  if [ -z "$branch" ]; then
    if printf '%s' "$meta" | /usr/bin/grep -q '"message": "Not Found"'; then
      die "$repo is not visible to your token — the owner's collaborator invite for $SENDER is pending (docs/REMOTE.md §1/§6)"
    fi
    die "could not read $repo: $(printf '%s' "$meta" | head -c 200)"
  fi

  local ref head tree b64 blobsha treeresp newtree
  ref=$(get "/repos/$repo/git/ref/heads/$branch")
  head=$(printf '%s' "$ref" | /usr/bin/perl -ne 'print $1 if /^\s*"sha": "([0-9a-f]{40})"/' | head -1)
  [ -n "$head" ] || die "no head on $repo:$branch"
  tree=$(get "/repos/$repo/git/commits/$head" | /usr/bin/perl -0777 -ne 'print $1 if /"tree":\s*\{[^{}]*?"sha":\s*"([0-9a-f]{40})"/s' | head -1)

  /bin/cat <(printf '%s\n' "$body") | base64 -b 0 > /tmp/radio.b64.$$
  printf '{"content":"%s","encoding":"base64"}' "$(/bin/cat /tmp/radio.b64.$$ | tr -d '\n')" > /tmp/radio.bjson.$$
  blobsha=$(call POST "/repos/$repo/git/blobs" /tmp/radio.bjson.$$ | /usr/bin/perl -ne 'print $1 if /^\s*"sha": "([0-9a-f]{40})"/' | head -1)
  [ -n "$blobsha" ] || die "blob upload failed"
  printf '{ "base_tree": "%s", "tree": [{"path": "%s", "mode": "100644", "type": "blob", "sha": "%s"}] }' \
    "$tree" "$path" "$blobsha" > /tmp/radio.tree.$$
  treeresp=$(call POST "/repos/$repo/git/trees" /tmp/radio.tree.$$)
  newtree=$(printf '%s' "$treeresp" | /usr/bin/perl -ne 'print $1 if /^\s*"sha": "([0-9a-f]{40})"/' | head -1)
  [ -n "$newtree" ] || die "tree creation failed: $(printf '%s' "$treeresp" | head -c 200)"

  local mname memail mdate
  mname=Mystra; memail="360961110+$SENDER@users.noreply.github.com"; mdate=$(iso_now)
  /usr/bin/perl -MJSON::PP -e '
    my $msg = do { local $/; open my $m, "<", $ARGV[0]; <$m> };
    my $a = { name => $ARGV[3], email => $ARGV[4], date => $ARGV[5] };
    print encode_json({ message => $msg, tree => $ARGV[1], parents => [$ARGV[2]], author => $a, committer => $a });
  ' <(printf 'relay messages from %s: %s -> %s\n\none note via the radio-pro applet (no git binary on the sending machine).\n\nCo-Authored-By: Mistral Vibe <vibe@mistral.ai>' "$MACHINE" "$SENDER" "$to") \
    "$newtree" "$head" "$mname" "$memail" "$mdate" > /tmp/radio.commit.$$
  local cref commitsha
  cref=$(call POST "/repos/$repo/git/commits" /tmp/radio.commit.$$)
  commitsha=$(printf '%s' "$cref" | /usr/bin/perl -ne 'print $1 if /^\s*"sha": "([0-9a-f]{40})"/' | head -1)
  [ -n "$commitsha" ] || die "commit creation failed: $(printf '%s' "$cref" | head -c 200)"
  rm -f /tmp/radio.b64.$$ /tmp/radio.bjson.$$ /tmp/radio.tree.$$ /tmp/radio.commit.$$

  printf '{ "sha": "%s", "force": false }' "$commitsha" > /tmp/radio.ref.$$
  local refres
  refres=$(call PATCH "/repos/$repo/git/refs/heads/$branch" /tmp/radio.ref.$$)
  rm -f /tmp/radio.ref.$$
  if printf '%s' "$refres" | /usr/bin/grep -q '"object"'; then
    printf 'sent: %s (commit %s)\n' "$path" "${commitsha:0:8}"
  else
    die "ref update failed (a race with the deck's own sync is the usual cause; send again): $(printf '%s' "$refres" | head -c 200)"
  fi
}

# ----------------------------------------------------------------- read ---

fetch_file() { # $1=repo $2=sha -> raw content on stdout
  /usr/bin/curl -s -H "${AUTH[0]}" -H "$RAW" "$API/repos/$1/git/blobs/$2"
}

parse_record() { # $1=body-file -> KEY: value lines (parse_message_file parity)
  /usr/bin/perl -0777 -ne '
    my ($head, $sep, $text) = /^(.*?)\n\n(.*)$/s ? ($1, undef, $2) : (undef, undef, undef);
    exit 1 unless defined $head && defined $text;
    my %f;
    for my $line (split /\n/, $head) {
      my ($name, $c, $val) = $line =~ /^([^:]+)(:)(.*)$/ or next;
      $f{lc $name} = $val =~ s/^\s+|\s+$//gr;
    }
    exit 2 unless $f{from} && $f{to} && $f{id};
    print "FROM: $f{from}\nTO: $f{to}\nTIME: ", ($f{time} // ""), "\nMACHINE: ", ($f{machine} // "(unknown)"), "\n";
    print "QUIET: ", ($f{quiet} eq "yes" ? "yes" : "no"), "\n";
    print "PRIVATE: ", ((($f{visibility} // "public") eq "private") ? "yes" : "no"), "\n";
    print "ID: $f{id}\nTEXT_BEGIN\n"; $text =~ s/\n+$//; print "$text\n";
  ' "$1"
}

list_note_paths() { # $1=repo -> sorted (newest last) list of "<sha> <path>" of messages/*.txt
  local meta branch ref head tree resp
  meta=$(get "/repos/$1") || true
  branch=$(printf '%s' "$meta" | /usr/bin/perl -0777 -ne 'print $1 if /"default_branch": "([^"]+)"/')
  [ -n "$branch" ] || { echo "ERR:$(printf '%s' "$meta" | friendly_missing)"; return 1; }
  ref=$(get "/repos/$1/git/ref/heads/$branch")
  head=$(printf '%s' "$ref" | /usr/bin/perl -ne 'print $1 if /^\s*"sha": "([0-9a-f]{40})"/' | head -1)
  [ -n "$head" ] || { echo "ERR:no head"; return 1; }
  get "/repos/$1/git/trees/$head?recursive=1" | \
    /usr/bin/perl -0777 -ne '
      if (/"truncated": true/) { print "ERR:tree truncated\n"; exit 0; }
      while (/"path": "(messages\/[^"]+\.txt)".*?"sha": "([0-9a-f]{40})"/sg) { print "$2 $1\n"; }
    ' | sort -r -k2
}

do_inbox() {
  local listed; listed=$(list_note_paths "$PUBLIC_REPO") || true
  case "$listed" in
    ERR:*) die "${listed#ERR:}";;
  esac
  : > /tmp/radio.inbox.$$
  local line sha path
  local found=0
  while IFS=' ' read -r sha path; do
    [ -n "$sha" ] || continue
    fetch_file "$PUBLIC_REPO" "$sha" > /tmp/radio.n.$$
    parse_record /tmp/radio.n.$$ > /tmp/radio.p.$$ || { continue; }
    local to id
    to=$(/usr/bin/sed -n 's/^TO: //p' /tmp/radio.p.$$ | head -1)
    id=$(/usr/bin/sed -n 's/^ID: //p' /tmp/radio.p.$$ | head -1)
    local hit=0 t
    for t in $(printf '%s' "$to" | tr '+' ' '); do
      [ "$t" = "$SENDER" ] && hit=1
      [ "$t" = "all" ] && hit=1
    done
    [ "$hit" = 1 ] || continue
    /usr/bin/grep -qxF "$id" "$STATE" 2>/dev/null && continue
    printf '%s\n' "== from $(/usr/bin/sed -n 's/^FROM: //p' /tmp/radio.p.$$ | head -1) at $(/usr/bin/sed -n 's/^TIME: //p' /tmp/radio.p.$$ | head -1) =="
    /usr/bin/awk '/^TEXT_BEGIN$/{f=1;next} f' /tmp/radio.p.$$
    printf '%s\n' ""
    printf '%s\n' "$id" >> /tmp/radio.inbox.$$
    found=1
  done <<EOF
$listed
EOF
  rm -f /tmp/radio.n.$$ /tmp/radio.p.$$
  cat /tmp/radio.inbox.$$ >> "$STATE" 2>/dev/null || true
  rm -f /tmp/radio.inbox.$$
  [ "$found" = 0 ] && printf 'no unread notes for %s\n' "$SENDER"
  return 0
}

do_watch() { # $1=N
  local n="${1:-10}"
  local listed; listed=$(list_note_paths "$PUBLIC_REPO") || true
  case "$listed" in
    ERR:*) die "${listed#ERR:}";;
  esac
  printf '%s\n' "$listed" | head -n "$n" | while IFS=' ' read -r sha path; do
    [ -n "$sha" ] || continue
    fetch_file "$PUBLIC_REPO" "$sha" > /tmp/radio.n.$$
    parse_record /tmp/radio.n.$$ > /tmp/radio.p.$$ || continue
    printf '%s\n' "== $(printf '%s' "$path" | sed 's|messages/||; s|\.txt$||') — from $(/usr/bin/sed -n 's/^FROM: //p' /tmp/radio.p.$$ | head -1) to $(/usr/bin/sed -n 's/^TO: //p' /tmp/radio.p.$$ | head -1) =="
    /usr/bin/awk '/^TEXT_BEGIN$/{f=1;next} f' /tmp/radio.p.$$
    printf '%s\n' ""
  done
  rm -f /tmp/radio.n.$$ /tmp/radio.p.$$
}

do_roster() {
  /usr/bin/curl -s -H "${AUTH[0]}" -H "$RAW" "$API/repos/$ROSTER_REPO/contents/README.md" > /tmp/radio.roster.$$
  /usr/bin/awk '/## Seats/,/^## [^S]/' /tmp/radio.roster.$$ | head -40
  printf '%s\n' "(roster source: $ROSTER_REPO README.md; update radio-pro.conf's SEATS line from this)"
  rm -f /tmp/radio.roster.$$
}

friendly_missing() { # repo-json on stdin -> friendly 404 line on stdout
  local meta
  meta=$(/bin/cat)
  if printf '%s' "$meta" | /usr/bin/grep -q '"message": "Not Found"'; then
    printf '%s\n' "the note repo is not visible to your token — the owner's collaborator invite for $SENDER is pending (docs/REMOTE.md §1/§6)"
  else
    printf '%s\n' "$(printf '%s' "$meta" | head -c 200)"
  fi
}

# ------------------------------------------------------------- self-test ---

check() { # $1=name $2=ok (shell exit code: 0 means pass) $3=detail
  if [ "$2" -eq 0 ]; then printf 'ok   %s\n' "$1"; else printf 'FAIL %s  %s\n' "$1" "${3:-}"; FAILS=$((FAILS+1)); fi
}

self_test() {
  FAILS=0
  local stamp id body path
  stamp="2026-11-25 04:10:12"
  id="1764041412000000000-neo-mac-1"

  # 1. byte parity with desktop message_file()
  body=$(compose "claude" "no" "public" "$stamp" "$id" "The text of the note.")
  EXPECTED="From: mystra
To: claude
Time: 2026-11-25 04:10:12
Machine: $MACHINE
Quiet: no
Visibility: public
Id: 1764041412000000000-neo-mac-1

The text of the note."
  [ "$body" = "$EXPECTED" ]; check "compose matches message_file() byte for byte" $? "got: $body"

  # 2. multi-recipient and quiet variants, and the visibility mapping
  body=$(compose $'claude+grok' "yes" "public" "$stamp" "$id" "hi")
  printf '%s' "$body" | /usr/bin/grep -q '^To: claude+grok$' && \
  printf '%s' "$body" | /usr/bin/grep -q '^Quiet: yes$' && \
  printf '%s' "$body" | /usr/bin/grep -q '^Visibility: public$'
  check "To joins with +, Quiet flips, public stays public" $?
  body=$(compose "grok" "no" "private" "$stamp" "$id" "hi")
  printf '%s' "$body" | /usr/bin/grep -q '^Visibility: private$'
  check "Visibility maps the private flag right" $?

  # 3. path parity
  path=$(msg_path "claude" "$stamp" "$id")
  printf '%s' "$path" | /usr/bin/grep -Eq '^messages/[0-9]{4}-[0-9]{2}-[0-9]{2}/[0-9]{6}-mystra-to-claude-[0-9A-Za-z_]+(-[0-9A-Za-z_]+)*\.txt$'
  check "path matches message_file()'s layout" $?

  # 4. round-trip through the parse parity
  body=$(compose "claude" "no" "public" "$stamp" "$id" "The text of the note.")
  printf '%s\n' "$body" > /tmp/radio.t.$$
  parse_record /tmp/radio.t.$$ > /tmp/radio.p.$$; rc=$?
  if [ $rc -eq 0 ] && \
     [ "$(/usr/bin/sed -n 's/^FROM: //p' /tmp/radio.p.$$ | head -1)" = "mystra" ] && \
     [ "$(/usr/bin/sed -n 's/^ID: //p' /tmp/radio.p.$$ | head -1)" = "$id" ] && \
     [ "$(/usr/bin/sed -n 's/^TO: //p' /tmp/radio.p.$$ | head -1)" = "claude" ] && \
     [ "$(/usr/bin/awk '/^TEXT_BEGIN$/{f=1;next} f' /tmp/radio.p.$$)" = "The text of the note." ]; then rc=0; else rc=1; fi
  check "parse_message_file() parity round-trips (from,to,id,text)" $rc

  # 5. inner blank lines stay body
  two=$'line one\n\ncounted paragraphs'
  body=$(compose "owner" "no" "public" "$stamp" "$id" "$two")
  printf '%s\n' "$body" > /tmp/radio.t.$$
  parse_record /tmp/radio.t.$$ > /tmp/radio.p.$$ 2>/dev/null
  [ "$(/usr/bin/awk '/^TEXT_BEGIN$/{f=1;next} f' /tmp/radio.p.$$)" = "$two" ]
  check "a paragraph break in the body survives the round-trip" $?

  # 6. secret refusal
  looks_secret "paste ghp_abcdefghij0123456789 here"; check "credential-shaped text is refused" $?
  looks_secret "hello, review when you can"; [ $? -ne 0 ]; check "an ordinary note passes the secret check" $?

  # 7. seat validation
  SEATS="claude grok"
  seat_allowed "claude"; check "a listed seat is sendable" $?
  seat_allowed "cluade"; [ $? -ne 0 ]; check "a misspelled seat is refused" $?
  seat_allowed "owner"; check "owner is always sendable" $?
  seat_allowed "all"; check "all is always sendable" $?

  # 8. repo routing by visibility
  local r1 r2
  r1="$PUBLIC_REPO"; r2="$PRIVATE_REPO"
  [ "$r1" = "$UP/flight-log" ] && [ "$r2" = "$UP/private-relay" ]
  check "public notes route to flight-log, private to private-relay" $?

  rm -f /tmp/radio.t.$$ /tmp/radio.p.$$
  printf '%s\n' ""
  if [ "$FAILS" -eq 0 ]; then printf '%s\n' "all passed"; return 0; fi
  printf '%s\n' "$FAILS failed"; return 1
}

# ------------------------------------------------------------------ main ---

cmd="${1:-help}"
case "$cmd" in
  send) shift
    DRY=no
    quiet=no; priv=no; file=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --quiet) quiet=yes;;
        --private) priv=private;;
        --file) file="$2"; shift;;
        --dry-run) DRY=yes;;
        -*) die "unknown flag $1";;
        *) break;;
      esac
      shift
    done
    [ $# -ge 1 ] || die "usage: radio-pro send [--quiet] [--private] [--file <path>] <to>... [\"<text>\"|-]"
    to="$1"; shift
    if [ -n "$file" ]; then
      [ -f "$file" ] || die "no such file: $file"
      text=$(/bin/cat "$file")
    elif [ $# -ge 1 ]; then
      if [ "$1" = "-" ]; then text=$(/bin/cat); else text="$1"; fi
    else
      text=""
    fi
    send_note "$to" "$quiet" "$priv" "$text";;
  inbox) do_inbox;;
  watch) shift; [ "${1:-}" = "-n" ] && { do_watch "${2:-10}"; } || do_watch 10;;
  roster) do_roster;;
  self-test) self_test;;
  help|*) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//';;
esac
